# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=linkworld

# Server Configuration
SERVER_PORT=8080

# Blockchain Configuration
# RPC_URL 覆盖 configs/deployments.json 的 rpcUrl（留空则以 json 为准，design §6.5 单一优先级）。
# 默认目标网络为 Arbitrum Sepolia (421614)；本地联调可指向 hardhat (31337)。
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
# CHAIN_ID 与 deployments.json.chainId 一致校验（不一致拒启动，防连错网/签错链）。
CHAIN_ID=421614

# owner = 平台 root 权限（能改分账地址/授权拓扑/凭空造单），最高危资损面。
# 仅本地/CI 用 env 注入；生产经 secret manager 注入进程环境（进程退出即失）。
# 禁止把真实私钥写入版本库；.env 已 gitignore，本模板留空。
ORACLE_OWNER_PRIVATE_KEY=
# 合约部署用私钥（仅部署侧用，后端运行时通常不需要）。
DEPLOYER_PRIVATE_KEY=

# 管理端点鉴权 key（AdminAuth，常量时间比较）。缺失则管理端点启动 fail。留空占位。
ADMIN_API_KEY=
